{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "flyback-arena-design-tokens",
    "version": "1.0.0",
    "reference_baseline": "twin-lakes-reference.jpg + boomerang/renderer/src/{hud,themes,voxchars}.py",
    "target_engines": [
      "Godot 4.4+ (Theme & GDExtension HUD)",
      "Static Admin WebUI (CSS Custom Properties)"
