      "banner_winner": 58,
      "team_score": 42,
      "timer": 34,
      "player_name": 26,
      "toast_name": 24,
      "warn_title": 24,
      "toast_body": 22,
      "entry_tag": 22,
      "player_status": 18,
      "mode_label": 15
    },
    "webui_px": {
      "page_title": 22,
      "kpi_value": 28,
      "section_title": 16,
      "body": 14,
      "caption": 12
    }
  },
  "geometry": {
    "style_doctrine": "sunlit-voxel-tactical",
    "avoid_excessive_rounding": true,
    "panel_radius_px": 4,
    "card_radius_px": 3,
    "control_radius_px": 2,
    "badge_radius_px": 2,
    "chamfer_px": 8,
    "border_width_px": 1.5,
    "accent_stripe_px": 3,
    "hard_shadow_offset_px": [3, 3],
    "allow_circles_only_for": [
      "character_avatar",
      "diegetic_cooldown_ring",
      "seat_0_emblem_circle"
    ]
  },
  "layout_1080p": {
    "reference_width": 1920,
    "reference_height": 1080,
    "top_bar": {
      "box": [24, 14, 1896, 106],
      "corner_radius": 4,
      "chamfer_px": 8,
      "center_clock_width": 190,
      "center_pill_half_width": 74,
      "center_pill_radius": 2,
      "avatar_size_ffa": 62,
      "card_radius": 3
    },
    "toast_stack": {
      "start_y": 122,
      "row_step_y": 60,
      "height": 50,
      "radius": 3,
      "avatar_size": 36,
      "max_visible": 2
    },
    "collapse_warn_bar": {
      "y": 122,
      "height": 48,
      "radius": 3
    },
    "winner_banner": {
      "y": 136,
      "height": 116,
      "radius": 4,
      "chamfer_px": 10,
      "avatar_size": 84,
      "accent_bar_height": 12
    }
  },
  "timings": {
    "tick_rate_hz": 20,
    "tick_ms": 50,
    "human_opponent_obs_delay_ticks": 0,
    "ai_opponent_obs_delay_ticks": 4,
    "ai_opponent_obs_delay_ms": 200,
    "spectator_delay_seconds": 3.0,
    "collapse_warn_ticks": 30,
    "recall_channel_ticks": 12,
    "dash_cooldown_ticks": 20,
    "kick_stun_ticks": 12,
    "expose_ticks": 20,
    "input_buffer_default_ticks": 2,
    "local_feedback_target_ms": 16.67,
    "prediction_reconcile_halflife_ms": 75,
    "pause_vote_timeout_seconds": 15,
    "webui_telemetry_hz": 1,
    "webui_process_metrics_seconds": 5
  },
