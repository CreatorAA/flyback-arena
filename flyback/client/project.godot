config_version=5

[application]
config/name="飞返竞技场 · Flyback Arena"
config/features=PackedStringArray("4.5", "Forward Plus")
run/main_scene="res://main.tscn"
config/icon="res://art/mark.svg"

[display]
window/size/viewport_width=1360
window/size/viewport_height=800
window/size/window_width_override=1600
window/size/window_height_override=900
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
scaling_3d/scale=1.0
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.49,0.74,0.84,1)
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=4096
